# Hash-locked build variant for persistent D3D12 compute pipeline libraries.
function(_rtr_pipeline_replace content_var anchor replacement output_var)
    set(content "${${content_var}}")
    string(FIND "${content}" "${anchor}" offset)
    if(offset LESS 0)
        message(FATAL_ERROR "D3D12 pipeline cache patch anchor is absent")
    endif()
    string(LENGTH "${anchor}" anchor_length)
    math(EXPR tail_offset "${offset} + ${anchor_length}")
    string(SUBSTRING "${content}" ${tail_offset} -1 tail)
    string(FIND "${tail}" "${anchor}" duplicate)
    if(NOT duplicate EQUAL -1)
        message(FATAL_ERROR "D3D12 pipeline cache patch anchor is not unique")
    endif()
    string(REPLACE "${anchor}" "${replacement}" content "${content}")
    set(${output_var} "${content}" PARENT_SCOPE)
endfunction()

function(rtr_apply_authorized_pipeline_cache_patch adapter_root)
    if(NOT TARGET nvrhi_d3d12)
        message(FATAL_ERROR "The persistent PSO cache requires the static nvrhi_d3d12 target")
    endif()
    set(source_root "${CMAKE_SOURCE_DIR}/External/Donut/nvrhi/src/d3d12")
    set(variant_root "${CMAKE_BINARY_DIR}/rtrenderer-patches/pipeline-cache")
    file(MAKE_DIRECTORY "${variant_root}")

    set(files d3d12-backend.h d3d12-device.cpp d3d12-resource-bindings.cpp d3d12-compute.cpp)
    set(expected_hashes
        a382af4bdbf07f43467485c5dd6376f08eabcb67132d3ebd6cd2f37bbea365b8
        47c4083ffd390837f3067e0e13b5cc8e609ab26c89c6a58a448954b83772ef86
        9d2474b6278f118e60548bc94e833228e7da29ab779517016b1c87cfcfa81016
        88c84e99061fd372756342fa692b10c799f99dcd1249973a328914bf182e1f1f)
    set(variants)
    set(original_inputs)
    set(manifest_files "")
    foreach(index RANGE 0 3)
        list(GET files ${index} name)
        list(GET expected_hashes ${index} expected_hash)
        set(original "${source_root}/${name}")
        list(APPEND original_inputs "${original}")
        file(SHA256 "${original}" original_hash)
        if(NOT original_hash STREQUAL expected_hash)
            message(FATAL_ERROR "D3D12 pipeline cache patch source identity differs: ${name}")
        endif()
        file(READ "${original}" content)
        string(REPLACE "\r\n" "\n" content "${content}")

        if(name STREQUAL "d3d12-backend.h")
            _rtr_pipeline_replace(content "#include <nvrhi/d3d12.h>\n" "#include <nvrhi/d3d12.h>\n#include <memory>\n\nnamespace rtr::upstream { class D3D12PipelineCache; }\n" content)
            _rtr_pipeline_replace(content "        size_t hash = 0;\n        static_vector<std::pair<BindingLayoutHandle, RootParameterIndex>, c_MaxBindingLayouts> pipelineLayouts;\n        RefCountPtr<ID3D12RootSignature> handle;\n" "        size_t hash = 0;\n        static_vector<std::pair<BindingLayoutHandle, RootParameterIndex>, c_MaxBindingLayouts> pipelineLayouts;\n        RefCountPtr<ID3D12RootSignature> handle;\n        std::vector<char> serialized;\n" content)
            _rtr_pipeline_replace(content "        Context m_Context;\n        DeviceResources m_Resources;\n" "        Context m_Context;\n        DeviceResources m_Resources;\n        std::unique_ptr<rtr::upstream::D3D12PipelineCache> m_PipelineCache;\n" content)
        elseif(name STREQUAL "d3d12-device.cpp")
            _rtr_pipeline_replace(content "#include \"d3d12-backend.h\"\n" "#include \"d3d12-backend.h\"\n#include \"rtxpt_embedded_startup.h\"\n#include \"rtxpt_d3d12_pipeline_cache.h\"\n" content)
            _rtr_pipeline_replace(content "        m_Context.messageCallback = desc.errorCB;\n" "        m_Context.messageCallback = desc.errorCB;\n\n        if (rtr::upstream::embeddedStartup && !rtr::upstream::embeddedStartup->pipelineCacheRoot.empty()) {\n            m_PipelineCache = std::make_unique<rtr::upstream::D3D12PipelineCache>();\n            if (!m_PipelineCache->Open(m_Context.device.Get(), rtr::upstream::embeddedStartup->pipelineCacheRoot))\n                m_Context.info(\"D3D12 compute pipeline library unavailable; using driver creation\");\n            else if (m_PipelineCache->CacheLoaded())\n                m_Context.info(\"D3D12 compute pipeline library loaded\");\n            else if (m_PipelineCache->CacheInvalidated())\n                m_Context.info(\"D3D12 compute pipeline library rejected; rebuilding it\");\n        }\n" content)
            _rtr_pipeline_replace(content "    Device::~Device()\n    {\n        waitForIdle();\n" "    Device::~Device()\n    {\n        waitForIdle();\n\n        if (m_PipelineCache) {\n            m_PipelineCache->Save();\n            m_Context.info(m_PipelineCache->Status());\n        }\n" content)
        elseif(name STREQUAL "d3d12-resource-bindings.cpp")
            _rtr_pipeline_replace(content "        return RootSignatureHandle::Create(rootsig);\n" "        rootsig->serialized.assign(static_cast<const char*>(rsBlob->GetBufferPointer()),\n            static_cast<const char*>(rsBlob->GetBufferPointer()) + rsBlob->GetBufferSize());\n        return RootSignatureHandle::Create(rootsig);\n" content)
        elseif(name STREQUAL "d3d12-compute.cpp")
            _rtr_pipeline_replace(content "#include \"d3d12-backend.h\"\n" "#include \"d3d12-backend.h\"\n#include \"rtxpt_d3d12_pipeline_cache.h\"\n" content)
            _rtr_pipeline_replace(content "        const HRESULT hr = m_Context.device->CreateComputePipelineState(&desc, IID_PPV_ARGS(&pipelineState));\n" "        const auto cacheName = rtr::upstream::ComputePipelineCacheName(\n            pRS->serialized.data(), pRS->serialized.size(), desc.CS.pShaderBytecode, desc.CS.BytecodeLength, desc.NodeMask, desc.Flags);\n        const HRESULT hr = m_PipelineCache\n            ? m_PipelineCache->CreateComputePipeline(m_Context.device.Get(), cacheName, desc, &pipelineState)\n            : m_Context.device->CreateComputePipelineState(&desc, IID_PPV_ARGS(&pipelineState));\n" content)
        endif()

        set(variant "${variant_root}/${name}")
        file(WRITE "${variant}" "${content}")
        file(SHA256 "${variant}" variant_hash)
        list(APPEND variants "${variant}")
        string(APPEND manifest_files "  \"${name}\": {\"officialSha256\": \"${original_hash}\", \"variantSha256\": \"${variant_hash}\"},\n")
    endforeach()

    get_target_property(target_sources nvrhi_d3d12 SOURCES)
    get_target_property(target_source_directory nvrhi_d3d12 SOURCE_DIR)
    set(selected_sources)
    set(copied_sources 0)
    foreach(source IN LISTS target_sources)
        get_filename_component(resolved_source "${source}" ABSOLUTE BASE_DIR "${target_source_directory}")
        get_filename_component(extension "${resolved_source}" EXT)
        if(extension STREQUAL ".cpp" AND resolved_source MATCHES "^${source_root}/")
            get_filename_component(name "${resolved_source}" NAME)
            list(FIND files "${name}" patch_index)
            if(patch_index GREATER 0)
                list(GET variants ${patch_index} variant)
            else()
                set(variant "${variant_root}/${name}")
                configure_file("${resolved_source}" "${variant}" COPYONLY)
            endif()
            list(APPEND selected_sources "${variant}")
            math(EXPR copied_sources "${copied_sources} + 1")
        else()
            list(APPEND selected_sources "${source}")
        endif()
    endforeach()
    if(copied_sources LESS 3)
        message(FATAL_ERROR "The D3D12 pipeline cache integration copied too few target sources")
    endif()
    set_property(TARGET nvrhi_d3d12 PROPERTY SOURCES "${selected_sources}")
    target_include_directories(nvrhi_d3d12 PRIVATE "${adapter_root}" "${source_root}")
    target_link_libraries(nvrhi_d3d12 PUBLIC bcrypt)
    file(WRITE "${variant_root}/manifest.json"
        "{\n  \"format\": \"rtr-authorized-d3d12-pipeline-cache-v1\",\n  \"target\": \"nvrhi_d3d12\",\n  \"copiedTargetSources\": ${copied_sources},\n  \"files\": {\n${manifest_files}    \"adapterHeader\": \"${adapter_root}/rtxpt_d3d12_pipeline_cache.h\"\n  },\n  \"officialSourcesUnmodified\": true\n}\n")
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
        "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/RtxptPipelineCachePatch.cmake"
        "${adapter_root}/rtxpt_d3d12_pipeline_cache.h"
        ${original_inputs})
endfunction()
