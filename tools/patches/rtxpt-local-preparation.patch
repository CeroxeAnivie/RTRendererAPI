+void Scene::HostRefreshMaterials(nvrhi::ICommandList* commandList,
+    const std::vector<std::shared_ptr<Material>>& materials)
+{
+    for (const auto& material : materials)
+    {
+        UpdateMaterial(material);
+        if (!material->materialConstants)
+            material->materialConstants = CreateMaterialConstantBuffer(material->name);
+        const auto& data = m_Resources->materialData.at(material->materialID);
+        commandList->writeBuffer(material->materialConstants, &data, sizeof(MaterialConstants));
+        if (m_EnableBindlessResources)
+            commandList->writeBuffer(m_MaterialBuffer, &data, sizeof(MaterialConstants),
+                size_t(material->materialID) * sizeof(MaterialConstants));
+        material->dirty = false;
+    }
+}
