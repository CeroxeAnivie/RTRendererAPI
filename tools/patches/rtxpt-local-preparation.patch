+bool MaterialsBaker::HostSyncChangedMaterials(const std::vector<std::shared_ptr<donut::engine::Material>>& materials) {
+    bool permutationsChanged=false;
+    for(const auto& material:materials) {
+        auto pt=PTMaterial::SafeCast(material);
+        if(!pt)throw std::runtime_error("Retained material has no path-tracing data");
+        if(!pt->BakedShaderPermutation || !(MaterialShaderPermutationKey(pt->ComputeShaderPermutation(m_relativeShaderSourcePath))
+            ==MaterialShaderPermutationKey(*pt->BakedShaderPermutation)))permutationsChanged=true;
+    }
+    // An actual shader permutation change invalidates the shared pipeline. Value
+    // and compatible texture edits keep the resident material list and GPU slots.
+    if(permutationsChanged)BakeShaderPermutations();
+    m_deferredTextureLoadInProgress=true;
+    return permutationsChanged;
+}
