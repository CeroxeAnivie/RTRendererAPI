+std::array<uint64_t, 8> Scene::HostTableUploadStatistics() const
+{
+    return m_Resources->tableUploadStatistics;
+}
+
+template<typename T>
+static void WriteSceneTable(nvrhi::ICommandList* commands, nvrhi::IBuffer* target,
+    const std::vector<T>& data, std::vector<T>& uploaded,
+    nvrhi::BufferHandle& uploadedTarget, uint64_t& uploadEpoch,
+    std::array<uint64_t, 8>& statistics, size_t table)
+{
+    if (data.empty()) return;
+    const uint64_t epoch = HostSceneTables::invalidationEpoch.load(std::memory_order_relaxed);
+    if (uploadEpoch != epoch)
+    {
+        uploaded.clear(); uploadedTarget = nullptr; uploadEpoch = epoch;
+    }
+    const size_t fullBytes = data.size() * sizeof(T);
+    statistics[6] += fullBytes;
+    if (uploadedTarget.Get() != target || uploaded.size() != data.size())
+    {
+        commands->writeBuffer(target, data.data(), fullBytes);
+        uploaded = data; uploadedTarget = target;
+        statistics[table] += fullBytes; ++statistics[table + 3];
+        return;
+    }
+    struct Run { size_t first, count; };
+    std::array<Run, 32> runs{}; size_t runCount = 0, changed = 0;
+    for (size_t i = 0; i < data.size();)
+    {
+        ++statistics[7];
+        if (std::memcmp(&data[i], &uploaded[i], sizeof(T)) == 0) { ++i; continue; }
+        const size_t first = i++;
+        while (i < data.size())
+        {
+            ++statistics[7];
+            if (std::memcmp(&data[i], &uploaded[i], sizeof(T)) == 0) break;
+            ++i;
+        }
+        changed += i - first;
+        if (runCount == runs.size() || changed > data.size() / 2)
+        {
+            // Bound command overhead for scattered or wholesale changes.
+            commands->writeBuffer(target, data.data(), fullBytes);
+            uploaded = data;
+            statistics[table] += fullBytes; ++statistics[table + 3];
+            return;
+        }
+        runs[runCount++] = {first, i - first};
+    }
+    for (size_t i = 0; i < runCount; ++i)
+    {
+        const auto run = runs[i]; const size_t bytes = run.count * sizeof(T);
+        commands->writeBuffer(target, data.data() + run.first, bytes, run.first * sizeof(T));
+        std::copy_n(data.data() + run.first, run.count, uploaded.data() + run.first);
+        statistics[table] += bytes; ++statistics[table + 3];
+    }
+}
 
