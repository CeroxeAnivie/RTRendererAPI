@@ -0,0 +1,11 @@
+#pragma once
+#include <atomic>
+#include <cstdint>
+
+namespace donut::engine::HostSceneTables
+{
+    // A failed resource transaction can discard recorded uploads. Its CPU
+    // images must not make a later transaction skip those GPU writes.
+    inline std::atomic<uint64_t> invalidationEpoch{1};
+    inline void Invalidate() { invalidationEpoch.fetch_add(1, std::memory_order_relaxed); }
+}
