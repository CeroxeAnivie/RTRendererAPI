+// RTR update material values without replacing the fixed GPU material storage.
+void MaterialsBaker::HostImportMaterial(donut::engine::Material& material) {
+    auto& ex=dynamic_cast<MaterialEx&>(material);
+    if(!ex.PTMaterial)ex.PTMaterial=std::make_shared<PTMaterial>();
+    ImportFromDonut(material,*ex.PTMaterial);ex.PTMaterial->DonutCounterpart=&material;
+    ex.PTMaterial->GPUDataDirty=true;material.dirty=true;
+}
+bool MaterialsBaker::HostSyncMaterials(const std::shared_ptr<ExtendedScene>& scene) {
+    std::vector<std::shared_ptr<PTMaterial>> next;
+    std::vector<bool> used(m_materialsGPU.size(),false);
+    std::unordered_set<PTMaterial*> resident;
+    for(auto& pt:m_materials)resident.insert(pt.get());
+    bool permutationsChanged=false;
+    for(auto& material:scene->GetSceneGraph()->GetMaterials()) {
+        auto& ex=dynamic_cast<MaterialEx&>(*material);
+        if(!ex.PTMaterial)HostImportMaterial(*material);
+        auto pt=ex.PTMaterial;
+        if(resident.count(pt.get())!=0)used.at(pt->GPUDataIndex)=true;
+        next.push_back(pt);
+    }
+    for(auto& pt:next)if(resident.count(pt.get())==0) {
+        auto free=std::find(used.begin(),used.end(),false);
+        size_t index=size_t(free-used.begin());
+        if(index>=RTXPT_MATERIAL_MAX_COUNT)throw std::runtime_error("Retained material capacity exceeded");
+        if(index==used.size()){used.push_back(true);m_materialsGPU.push_back({});}else used[index]=true;
+        pt->GPUDataIndex=uint(index);pt->GPUDataDirty=true;
+    }
+    permutationsChanged=next.size()!=m_materials.size();
+    for(auto& pt:next) {
+        if(!resident.count(pt.get()) || !pt->BakedShaderPermutation
+            || !(MaterialShaderPermutationKey(pt->ComputeShaderPermutation(m_relativeShaderSourcePath))==MaterialShaderPermutationKey(*pt->BakedShaderPermutation)))permutationsChanged=true;
+    }
+    m_materials=std::move(next);m_textures.clear();
+    if(permutationsChanged){
+        m_uniqueNames.clear();for(auto& pt:m_materials)InitializeUniqueDeterministicName(pt);
+        BakeShaderPermutations();
+    }
+    m_deferredTextureLoadInProgress=true;return permutationsChanged;
+}
