+bool donut::engine::SceneGraph::HostRefreshLeafNodes(const std::vector<SceneGraphNode*>& nodes)
+{
+    if(HasPendingStructureChanges()||HasPendingTransformChanges())return false;
+    for(auto* node:nodes)if(!node||node->m_Graph.lock().get()!=this||!node->m_Children.empty()||!node->m_Leaf)return false;
+    std::unordered_set<SceneGraphNode*> ancestors;
+    for(auto* node:nodes){
+        node->m_LeafContent=node->m_Leaf->GetContentFlags();node->m_SubgraphContent=node->m_LeafContent;
+        auto bounds=node->m_Leaf->GetLocalBoundingBox();
+        node->m_GlobalBoundingBox=bounds.isempty()?dm::box3::empty():bounds*node->m_GlobalTransformFloat;
+        for(auto* parent=node->m_Parent;parent;parent=parent->m_Parent)ancestors.insert(parent);
+    }
+    std::vector<std::pair<size_t,SceneGraphNode*>> ordered;
+    for(auto* node:ancestors){size_t depth=0;for(auto* p=node->m_Parent;p;p=p->m_Parent)++depth;ordered.emplace_back(depth,node);}
+    std::sort(ordered.begin(),ordered.end(),[](const auto& a,const auto& b){return a.first>b.first;});
+    for(auto& entry:ordered){auto* node=entry.second;
+        auto bounds=node->m_Leaf?node->m_Leaf->GetLocalBoundingBox():dm::box3::empty();
+        node->m_GlobalBoundingBox=bounds.isempty()?dm::box3::empty():bounds*node->m_GlobalTransformFloat;
+        node->m_SubgraphContent=node->m_LeafContent;
+        for(auto& child:node->m_Children){node->m_GlobalBoundingBox|=child->m_GlobalBoundingBox;node->m_SubgraphContent|=child->m_SubgraphContent;}
+    }
+    return true;
+}
 
