+{
+    if(m_SceneGraph->HasPendingStructureChanges()||m_SceneGraph->HasPendingTransformChanges())Refresh(commandList,frameIndex);
+    CreateSelectedMeshBuffers(commandList, meshes);
+    for(const auto& mesh:meshes) {
+        mesh->buffers->instanceBuffer=m_InstanceBuffer;
+        UpdateGeometry(mesh);
+        for(const auto& geometry:mesh->geometries) {
+            const auto& data=m_Resources->geometryData.at(geometry->globalGeometryIndex);
+            commandList->writeBuffer(m_GeometryBuffer,&data,sizeof(GeometryData),size_t(geometry->globalGeometryIndex)*sizeof(GeometryData));
+        }
+    }
+}
