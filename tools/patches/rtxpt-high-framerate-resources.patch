+void OmmBuildQueue::CancelMesh(const donut::engine::MeshInfo* mesh)
+{
+    // Submitted storage stays alive until the queue's completion gate retires it.
+    std::unordered_set<const SharedBake*> groups;
+    for(auto& task:m_pending)if(task.input.mesh.get()==mesh){task.cancelled=true;if(task.sharedBake)groups.insert(task.sharedBake.get());}
+    for(auto& task:m_pending)if(task.sharedBake&&groups.count(task.sharedBake.get()))task.cancelled=true;
+    for(auto i=m_sharedBakes.begin();i!=m_sharedBakes.end();) {
+        bool remove=groups.count(i->second.get())!=0;
+        if(remove)i=m_sharedBakes.erase(i);else ++i;
+    }
+}
