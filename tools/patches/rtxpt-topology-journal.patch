+// The authoritative graph journal already knows which dense rows changed.
+// Preserve the uploaded mirror for the ordinary/full fallback without rescanning
+// it. Large/scattered deltas retain the existing bounded full-write fallback.
+template<typename T>
+static void WriteChangedSceneRows(nvrhi::ICommandList* commands,nvrhi::IBuffer* target,
+    const std::vector<T>& data,std::vector<T>& uploaded,std::vector<uint32_t>& rows,
+    std::array<uint64_t,8>& statistics,size_t table)
+{
+    if(rows.empty())return;
+    RtrDiagnostics::Scope evidence(RtrDiagnostics::SceneTableUpload,rows.size(),table,1,0,table+1,RtrDiagnostics::revision.load(),0,rows.size()*sizeof(T));
+    std::sort(rows.begin(),rows.end());rows.erase(std::unique(rows.begin(),rows.end()),rows.end());
+    size_t runs=1;for(size_t i=1;i<rows.size();++i)runs+=rows[i]!=rows[i-1]+1;
+    statistics[6]+=data.size()*sizeof(T);
+    if(runs>32||rows.size()>data.size()/2){
+        commands->writeBuffer(target,data.data(),data.size()*sizeof(T));uploaded=data;
+        statistics[table]+=data.size()*sizeof(T);++statistics[table+3];return;
+    }
+    for(size_t first=0;first<rows.size();){
+        size_t end=first+1;while(end<rows.size()&&rows[end]==rows[end-1]+1)++end;
+        const size_t row=rows[first],count=end-first,bytes=count*sizeof(T);
+        commands->writeBuffer(target,data.data()+row,bytes,row*sizeof(T));
+        std::copy_n(data.data()+row,count,uploaded.data()+row);
+        statistics[table]+=bytes;++statistics[table+3];first=end;
+    }
+}
