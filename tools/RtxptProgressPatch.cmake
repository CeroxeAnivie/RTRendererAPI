# Progress-window exception; the separate network exception is audited independently.
# The verified official export stays read-only.
function(rtr_apply_authorized_progress_patch)
    set(original "${CMAKE_SOURCE_DIR}/Rtxpt/SampleCommon/SampleCommon.cpp")
    set(expected "fe2d1d29021ca6506707a3ea8749ffa37c6d33491fc321e045a16a84bc3742e0")
    set(patch "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/patches/progress-noninteractive.patch")
    file(SHA256 "${original}" original_sha)
    if(NOT original_sha STREQUAL expected)
        message(FATAL_ERROR "Progress patch requires the exact locked SampleCommon.cpp; got ${original_sha}")
    endif()
    file(READ "${original}" content)
    string(SHA256 read_sha "${content}")
    if(NOT read_sha STREQUAL original_sha)
        # CMake text reads normalize CRLF. Reconstruct and verify locked bytes.
        string(REPLACE "\n" "\r\n" content "${content}")
        string(SHA256 read_sha "${content}")
    endif()
    if(NOT read_sha STREQUAL original_sha)
        message(FATAL_ERROR "Progress patch source read did not preserve exact bytes")
    endif()
    set(anchor "int ProgressBarStart(const char * windowText)\r\n{\r\n")
    set(insertion "    if (HelpersIsNonInteractive())\r\n        return -1;\r\n\r\n")
    string(FIND "${content}" "${anchor}" anchor_offset)
    if(anchor_offset LESS 0)
        message(FATAL_ERROR "Exact ProgressBarStart patch anchor is absent")
    endif()
    string(LENGTH "${anchor}" anchor_size)
    math(EXPR after_anchor "${anchor_offset} + ${anchor_size}")
    string(SUBSTRING "${content}" ${after_anchor} -1 remainder)
    string(FIND "${remainder}" "${anchor}" duplicate_anchor)
    if(NOT duplicate_anchor EQUAL -1)
        message(FATAL_ERROR "ProgressBarStart patch anchor is not unique")
    endif()
    string(REPLACE "${anchor}" "${anchor}${insertion}" patched "${content}")
    string(REPLACE "${anchor}${insertion}" "${anchor}" reversed "${patched}")
    if(NOT reversed STREQUAL content)
        message(FATAL_ERROR "Progress patch contains changes outside its sole insertion")
    endif()
    set(output_directory "${CMAKE_BINARY_DIR}/rtrenderer-patches/progress-noninteractive")
    set(variant "${output_directory}/SampleCommon.cpp")
    file(MAKE_DIRECTORY "${output_directory}")
    string(SHA256 variant_sha "${patched}")
    set(write_variant TRUE)
    if(EXISTS "${variant}")
        file(SHA256 "${variant}" existing_sha)
        if(existing_sha STREQUAL variant_sha)
            set(write_variant FALSE)
        endif()
    endif()
    if(write_variant)
        # Write with an explicit newline policy; Windows text writes otherwise
        # turn verified CRLF into CRCRLF.
        string(REPLACE "\r\n" "\n" write_content "${patched}")
        file(CONFIGURE OUTPUT "${variant}" CONTENT "${write_content}"
            @ONLY NEWLINE_STYLE CRLF)
    endif()
    file(SHA256 "${variant}" written_sha)
    if(NOT written_sha STREQUAL variant_sha)
        message(FATAL_ERROR "Progress variant output bytes differ")
    endif()
    get_target_property(sources RtxptCore SOURCES)
    set(replacements 0)
    set(selected_sources)
    foreach(source IN LISTS sources)
        if(source STREQUAL original)
            list(APPEND selected_sources "${variant}")
            math(EXPR replacements "${replacements} + 1")
        else()
            list(APPEND selected_sources "${source}")
        endif()
    endforeach()
    if(NOT replacements EQUAL 1)
        message(FATAL_ERROR "Progress patch must replace exactly one RtxptCore source; got ${replacements}")
    endif()
    set_property(TARGET RtxptCore PROPERTY SOURCES "${selected_sources}")
    # Preserve the original quoted-include lookup without changing source text.
    set_source_files_properties("${variant}" DIRECTORY "${CMAKE_SOURCE_DIR}/Rtxpt"
        PROPERTIES INCLUDE_DIRECTORIES "${CMAKE_SOURCE_DIR}/Rtxpt/SampleCommon")
    file(SHA256 "${patch}" patch_sha)
    file(WRITE "${output_directory}/manifest.json"
        "{\n  \"officialSource\": \"${original}\",\n  \"officialSha256\": \"${original_sha}\",\n  \"variantSource\": \"${variant}\",\n  \"variantSha256\": \"${variant_sha}\",\n  \"patch\": \"${patch}\",\n  \"patchSha256\": \"${patch_sha}\",\n  \"target\": \"RtxptCore\",\n  \"officialFileVariants\": 1,\n  \"replacedTargetSources\": ${replacements},\n  \"hunks\": 1,\n  \"interactiveBodyByteIdentical\": true,\n  \"officialExportUnmodified\": true\n}\n")
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${original}" "${patch}")
    message(STATUS "Authorized progress-only variant: ${original_sha} -> ${variant_sha}; target sources replaced=1")
endfunction()
