#version 460
#extension GL_EXT_ray_tracing : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_EXT_buffer_reference : require
#define RTRENDERER_NO_DIELECTRIC 1
#define GS_LIGHTING_NO_DIRECT_SURFACE 1
#include "gpuscene_surface_transport.glsl"
layout(set=0,binding=GPU_SCENE_BINDING_TLAS) uniform accelerationStructureEXT sceneTlas;
layout(location=0) rayPayloadEXT GpuScenePayload payload;
#include "gpuscene_surface_lighting_runtime.glsl"
layout(buffer_reference,std430,buffer_reference_align=16) buffer GsDensityScatteringStorage {uvec4 lanes[];};
layout(push_constant) uniform GsDensityScatteringDispatch {
    GsDensityScatteringStorage storage;uint firstPixel;uint pixelCount;uint64_t reserved0;uint64_t reserved1;
} dispatch;
vec2 gsDensitySampleOffset(uint sampleIndex,uint samples) {
    if(samples==1u)return vec2(.5);
    if(samples==2u)return sampleIndex==0u?vec2(.25):vec2(.75);
    if(samples==4u){const vec2 p[4]=vec2[](vec2(.375,.125),vec2(.875,.375),vec2(.125,.625),vec2(.625,.875));return p[sampleIndex];}
    const vec2 p[8]=vec2[](vec2(.5,.3333),vec2(.25,.6667),vec2(.75,.1111),vec2(.125,.4444),
        vec2(.625,.7778),vec2(.375,.2222),vec2(.875,.5556),vec2(.0625,.8889));return p[sampleIndex];
}
float gsDensityPhase(float cosine,float g) {
    float c=clamp(cosine,-1.0,1.0),edge=1.0-abs(g),d=edge*edge+2.0*abs(g)*(1.0-sign(g)*c);
    return ((1.0-g)*(1.0+g))/(4.0*GS_PI*d*sqrt(d));
}
float gsDensityLightWeight(uint slot,vec3 origin,vec3 direction,float distance) {
    uint base=slot*GPU_SCENE_LIGHT_RECORD_WORDS,flags=gsLights.words[base+GPU_SCENE_LIGHT_FLAGS_WORD];
    if((flags&GPU_SCENE_FLAG_ACTIVE)==0u)return 0.0;
    if(((flags>>1u)&7u)!=GPU_SCENE_LIGHT_DIRECTIONAL) {
        vec3 point=vec3(gsFiniteDoubleAsFloat(gsLights.words[base+GPU_SCENE_LIGHT_POSITION_X_WORD],gsLights.words[base+GPU_SCENE_LIGHT_POSITION_X_WORD+1u]),
            gsFiniteDoubleAsFloat(gsLights.words[base+GPU_SCENE_LIGHT_POSITION_Y_WORD],gsLights.words[base+GPU_SCENE_LIGHT_POSITION_Y_WORD+1u]),
            gsFiniteDoubleAsFloat(gsLights.words[base+GPU_SCENE_LIGHT_POSITION_Z_WORD],gsLights.words[base+GPU_SCENE_LIGHT_POSITION_Z_WORD+1u]));
        if(length(point-origin-direction*clamp(dot(point-origin,direction),0.0,distance))>=uintBitsToFloat(gsLights.words[base+GPU_SCENE_LIGHT_RANGE_WORD]))return 0.0;
    }
    vec3 color=vec3(uintBitsToFloat(gsLights.words[base+GPU_SCENE_LIGHT_COLOR_WORD]),uintBitsToFloat(gsLights.words[base+GPU_SCENE_LIGHT_COLOR_WORD+1u]),
        uintBitsToFloat(gsLights.words[base+GPU_SCENE_LIGHT_COLOR_WORD+2u]));
    return gsLuminance(color)*uintBitsToFloat(gsLights.words[base+GPU_SCENE_LIGHT_INTENSITY_WORD]);
}
void gsDensityConnection(uint outLane,uint slot,bool sun,vec3 position,vec3 rayDirection,float g,float factor) {
    vec3 direction,color;float distance=1e20,intensity,attenuation=1.0;bool shadow;
    if(sun) {
        direction=-normalize(gsFrameVec3(GPU_SCENE_FRAME_SUN_DIRECTION_WORD));
        color=gsFrameVec3(GPU_SCENE_FRAME_SUN_COLOR_WORD);intensity=uintBitsToFloat(gsFrame.words[GPU_SCENE_FRAME_SUN_INTENSITY_WORD]);shadow=true;
    }else {
        uint base=slot*GPU_SCENE_LIGHT_RECORD_WORDS,flags=gsLights.words[base+GPU_SCENE_LIGHT_FLAGS_WORD],type=(flags>>1u)&7u;
        color=vec3(uintBitsToFloat(gsLights.words[base+GPU_SCENE_LIGHT_COLOR_WORD]),uintBitsToFloat(gsLights.words[base+GPU_SCENE_LIGHT_COLOR_WORD+1u]),
            uintBitsToFloat(gsLights.words[base+GPU_SCENE_LIGHT_COLOR_WORD+2u]));
        intensity=uintBitsToFloat(gsLights.words[base+GPU_SCENE_LIGHT_INTENSITY_WORD]);shadow=(flags&GPU_SCENE_FLAG_CASTS_SHADOW)!=0u;
        if(type==GPU_SCENE_LIGHT_DIRECTIONAL)direction=-normalize(vec3(uintBitsToFloat(gsLights.words[base+GPU_SCENE_LIGHT_DIRECTION_WORD]),
            uintBitsToFloat(gsLights.words[base+GPU_SCENE_LIGHT_DIRECTION_WORD+1u]),uintBitsToFloat(gsLights.words[base+GPU_SCENE_LIGHT_DIRECTION_WORD+2u])));
        else {
            vec3 point=vec3(gsFiniteDoubleAsFloat(gsLights.words[base+GPU_SCENE_LIGHT_POSITION_X_WORD],gsLights.words[base+GPU_SCENE_LIGHT_POSITION_X_WORD+1u]),
                gsFiniteDoubleAsFloat(gsLights.words[base+GPU_SCENE_LIGHT_POSITION_Y_WORD],gsLights.words[base+GPU_SCENE_LIGHT_POSITION_Y_WORD+1u]),
                gsFiniteDoubleAsFloat(gsLights.words[base+GPU_SCENE_LIGHT_POSITION_Z_WORD],gsLights.words[base+GPU_SCENE_LIGHT_POSITION_Z_WORD+1u]));
            vec3 delta=point-position;distance=length(delta);if(distance<=1e-8)return;direction=delta/distance;
            float range=uintBitsToFloat(gsLights.words[base+GPU_SCENE_LIGHT_RANGE_WORD]),fade=max(1.0-distance/range,0.0);
            attenuation=fade*fade/max(distance*distance,1.0);
            if(type==GPU_SCENE_LIGHT_SPOT) {
                vec3 axis=normalize(vec3(uintBitsToFloat(gsLights.words[base+GPU_SCENE_LIGHT_DIRECTION_WORD]),
                    uintBitsToFloat(gsLights.words[base+GPU_SCENE_LIGHT_DIRECTION_WORD+1u]),uintBitsToFloat(gsLights.words[base+GPU_SCENE_LIGHT_DIRECTION_WORD+2u])));
                float inner=uintBitsToFloat(gsLights.words[base+GPU_SCENE_LIGHT_INNER_CONE_WORD]),outer=uintBitsToFloat(gsLights.words[base+GPU_SCENE_LIGHT_OUTER_CONE_WORD]);
                float cone=dot(axis,-direction);attenuation*=inner==outer?step(outer,cone):smoothstep(outer,inner,cone);
            }
        }
    }
    if(attenuation<=0.0||intensity<=0.0)return;
    float range=max(distance-2.0*gsRayEpsilon(position),gsRayEpsilon(position));
    vec3 visibility=shadow?gsShadowTransmittance(position,direction,direction,range):vec3(1);
    vec3 source=color*(intensity*attenuation*factor*gsDensityPhase(dot(rayDirection,direction),g))*visibility;
    dispatch.storage.lanes[outLane]=floatBitsToUint(vec4(source,shadow?range:-1.0));
    dispatch.storage.lanes[outLane+1u]=floatBitsToUint(vec4(direction,0));
}
void main() {
    if(gl_LaunchIDEXT.x>=dispatch.pixelCount)return;
    uint samples=dispatch.storage.lanes[1].z,phase=dispatch.storage.lanes[1].w,steps=dispatch.storage.lanes[0].w;
    uint pixelIndex=dispatch.firstPixel+gl_LaunchIDEXT.x;
    ivec2 extent=ivec2(gsFrame.words[GPU_SCENE_FRAME_EXTENT_WORD],gsFrame.words[GPU_SCENE_FRAME_EXTENT_WORD+1u]);
    ivec2 pixel=ivec2(pixelIndex%uint(extent.x),pixelIndex/uint(extent.x));
    uint rayOffset=dispatch.storage.lanes[2].w/16u,sampleOffset=dispatch.storage.lanes[7].z/16u,connectionOffset=dispatch.storage.lanes[7].w/16u;
    uint primaryOffset=dispatch.storage.lanes[2].x/16u,first=dispatch.storage.lanes[8].x,connections=dispatch.storage.lanes[8].y,upper=dispatch.storage.lanes[8].z,lightSamples=dispatch.storage.lanes[8].w;
    float maximum=uintBitsToFloat(dispatch.storage.lanes[3]).w,g=uintBitsToFloat(dispatch.storage.lanes[4]).w;
    uint seed=gsTransportHash(pixelIndex^gsFrame.words[GPU_SCENE_FRAME_SEQUENCE_WORD]*0x9e3779b9u);
    vec2 jitter=vec2(uintBitsToFloat(gsFrame.words[GPU_SCENE_FRAME_CURRENT_JITTER_WORD]),uintBitsToFloat(gsFrame.words[GPU_SCENE_FRAME_CURRENT_JITTER_WORD+1u]));
    for(uint sampleIndex=0u;sampleIndex<samples;++sampleIndex) {
        uint local=gl_LaunchIDEXT.x*samples+sampleIndex,item=pixelIndex*samples+sampleIndex;
        vec3 origin,direction;
        if(phase==0u) {
            vec2 location=vec2(pixel)+gsDensitySampleOffset(sampleIndex,samples);if(!gsExactProjectionActive())location+=jitter;
            origin=gsFrameCameraPosition();direction=gsRayDirectionAtSample(location,extent);
            dispatch.storage.lanes[rayOffset+local*2u]=floatBitsToUint(vec4(origin,0));
            dispatch.storage.lanes[rayOffset+local*2u+1u]=floatBitsToUint(vec4(direction,0));continue;
        }
        origin=uintBitsToFloat(dispatch.storage.lanes[rayOffset+local*2u]).xyz;direction=uintBitsToFloat(dispatch.storage.lanes[rayOffset+local*2u+1u]).xyz;
        vec4 hit=uintBitsToFloat(dispatch.storage.lanes[primaryOffset+item*13u]);
        float distance=dispatch.storage.lanes[primaryOffset+item*13u+7u].x!=0u?min(max(hit.w,0.0),maximum):maximum;
        uint selected[8],small[8],candidates=0u;float total=0.0;
        if(lightSamples>0u)for(uint slot=0u;slot<upper;++slot) {
            float weight=gsDensityLightWeight(slot,origin,direction,distance);if(weight<=0.0)continue;
            if(candidates<8u)small[candidates]=slot;++candidates;total+=weight;
            for(uint k=0u;k<lightSamples;++k)if(gsTransportRandom(seed^slot*0x85ebca6bu^k*0xc2b2ae35u)<weight/total)selected[k]=slot;
        }
        payload.launchInfo=uvec4(pixel,extent);
        for(uint j=0u;j<steps;++j) {
            vec4 position=uintBitsToFloat(dispatch.storage.lanes[sampleOffset+(local*steps+j)*2u]);
            for(uint k=0u;k<connections;++k) {
                uint outLane=connectionOffset+((local*steps+j)*connections+k)*2u;
                dispatch.storage.lanes[outLane]=uvec4(0);dispatch.storage.lanes[outLane+1u]=uvec4(0);
                if(position.w==0.0)continue;uint ordinal=first+k;
                if(ordinal==0u){gsDensityConnection(outLane,0u,true,position.xyz,direction,g,1.0);continue;}
                uint choice=ordinal-1u,slot;float factor=1.0;
                if(lightSamples==0u) {if(choice>=upper)continue;slot=choice;if(gsDensityLightWeight(slot,origin,direction,distance)<=0.0)continue;}
                else {
                    bool exhaustive=candidates<=lightSamples;uint count=exhaustive?candidates:lightSamples;if(choice>=count)continue;
                    slot=exhaustive?small[choice]:selected[choice];
                    if(!exhaustive)factor=total/(float(lightSamples)*gsDensityLightWeight(slot,origin,direction,distance));
                }
                gsDensityConnection(outLane,slot,false,position.xyz,direction,g,factor);
            }
        }
    }
}
