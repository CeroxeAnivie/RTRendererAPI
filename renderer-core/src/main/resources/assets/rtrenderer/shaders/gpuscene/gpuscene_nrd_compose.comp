#version 460

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0, rgba16f) uniform readonly image2D traceImage;
layout(set = 0, binding = 1, rgba16f) uniform readonly image2D noisyDiffuse;
layout(set = 0, binding = 2, rgba16f) uniform readonly image2D noisySpecular;
layout(set = 0, binding = 3, r32f) uniform readonly image2D denoisingViewZ;
layout(set = 0, binding = 4, rgba16f) uniform readonly image2D denoisedDiffuse;
layout(set = 0, binding = 5, rgba16f) uniform readonly image2D denoisedSpecular;
layout(set = 0, binding = 6, rgba16f) uniform readonly image2D diffuseMaterialFactor;
layout(set = 0, binding = 7, rgba16f) uniform readonly image2D specularMaterialFactor;
#ifdef RTRENDERER_LINEAR_HDR_OUTPUT
layout(set = 0, binding = 8, rgba16f) uniform writeonly image2D outputImage;
#else
layout(set = 0, binding = 8, rgba8) uniform writeonly image2D outputImage;
#endif

vec3 ycocgToRgb(vec3 value)
{
    return vec3(
        value.x + value.y - value.z,
        value.x + value.z,
        value.x - value.y - value.z
    );
}

vec3 toneMap(vec3 color)
{
    vec3 mapped = (color * (2.51 * color + 0.03)) / (color * (2.43 * color + 0.59) + 0.14);
    return pow(clamp(mapped, vec3(0.0), vec3(1.0)), vec3(1.0 / 2.2));
}

void main()
{
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 extent = imageSize(outputImage);
    if (any(greaterThanEqual(pixel, extent))) return;

    vec3 trace = imageLoad(traceImage, pixel).rgb;
    float viewZ = imageLoad(denoisingViewZ, pixel).r;
    if (!(viewZ < 1.0e6)) {
        imageStore(outputImage, pixel, vec4(trace, 1.0));
        return;
    }
    vec3 diffuseFactor = imageLoad(diffuseMaterialFactor, pixel).rgb;
    vec3 specularFactor = imageLoad(specularMaterialFactor, pixel).rgb;
    vec3 noisy = ycocgToRgb(imageLoad(noisyDiffuse, pixel).rgb) * diffuseFactor
        + ycocgToRgb(imageLoad(noisySpecular, pixel).rgb) * specularFactor;
    vec3 denoised = ycocgToRgb(imageLoad(denoisedDiffuse, pixel).rgb) * diffuseFactor
        + ycocgToRgb(imageLoad(denoisedSpecular, pixel).rgb) * specularFactor;
    vec3 resolved = max(trace + denoised - noisy, vec3(0.0));
#ifdef RTRENDERER_LINEAR_HDR_OUTPUT
    imageStore(outputImage, pixel, vec4(resolved, 1.0));
#else
    imageStore(outputImage, pixel, vec4(toneMap(resolved), 1.0));
#endif
}
