#version 460

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0, rgba16f) uniform readonly image2D reconstructionImage;
layout(set = 0, binding = 1, rgba8) uniform writeonly image2D publishedImage;

vec3 toneMap(vec3 color)
{
    vec3 mapped = (color * (2.51 * color + 0.03)) / (color * (2.43 * color + 0.59) + 0.14);
    return pow(clamp(mapped, vec3(0.0), vec3(1.0)), vec3(1.0 / 2.2));
}

void main()
{
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(pixel, imageSize(publishedImage)))) return;
    imageStore(publishedImage, pixel, vec4(toneMap(imageLoad(reconstructionImage, pixel).rgb), 1.0));
}
