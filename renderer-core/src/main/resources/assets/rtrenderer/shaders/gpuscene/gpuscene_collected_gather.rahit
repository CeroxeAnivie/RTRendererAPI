#version 460
#extension GL_EXT_ray_tracing : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#include "gpuscene_common.glsl"
#include "gpuscene_collected_batch_data.glsl"
layout(location=2) rayPayloadInEXT GsCollectedBatchData batch;
hitAttributeEXT vec2 hitAttributes;
GpuScenePayload payload;
#include "gpuscene_boundary_intersection.glsl"
float gsCollectedTolerance(float t) {return 8.0*1.192092896e-7*max(1.0,abs(t));}
void countEvent(uint stage) {
#ifdef RTRENDERER_OPTICAL_PROFILE
    if(batch.diagnosticAddress!=0ul&&gsDetailActive(stage)) {
        uint word=(batch.diagnosticRecord*184u+stage)*2u;
        GsOpticalDiagnostic target=GsOpticalDiagnostic(batch.diagnosticAddress);
        target.values[word+1u]+=1ul;
    }
#endif
}
void collectCandidate() {
    countEvent(179u);
    uint instance=gl_InstanceCustomIndexEXT,primitive=gl_PrimitiveID;
    uint boundary=gsInstanceWord(instance,GPU_SCENE_INSTANCE_MEDIUM_BOUNDARY_FLAGS_WORD);
    uint mesh=gsMeshBase(gsInstanceMeshSlot(instance));
    uint material=gsTriangleMaterialSlot(mesh,primitive)*GPU_SCENE_MATERIAL_RECORD_WORDS;
    uint flags=gsMaterials.words[material+GPU_SCENE_MATERIAL_FLAGS_WORD];
    if((boundary&2u)==0u) {
        if((flags&GPU_SCENE_FLAG_ACTIVE)==0u)return;
        if(boundary==0u&&(flags&GPU_SCENE_FLAG_DOUBLE_SIDED)==0u
                &&gl_HitKindEXT!=gl_HitKindFrontFacingTriangleEXT)return;
    }
    vec2 bary=hitAttributes;
    float rawT=gl_HitTEXT,distance=rawT;
    if(min(1.0-bary.x-bary.y,min(bary.x,bary.y))<8.0*1.192092896e-7) {
        countEvent(183u);batch.fallback=true;return;
    }
    if(boundary!=0u)
        if(!gsBoundaryTriangleHit(mesh,primitive,bary,distance)||distance<batch.originAndMinimum.w)return;
    if(isnan(distance)||isinf(distance)||abs(distance-rawT)>gsCollectedTolerance(rawT)) {
        batch.fallback=true;return;
    }
    for(uint j=0u;j<batch.count;++j)
        if(all(equal(batch.events[j].identity.xy,uvec2(instance,primitive)))
                &&batch.events[j].distance.x==rawT)return;
    GsCollectedEvent event=GsCollectedEvent(uvec4(instance,primitive,floatBitsToUint(bary)),vec2(rawT,distance));
    uint position=0u;
    while(position<batch.count&&batch.events[position].distance.x<rawT)++position;
    if(batch.count==GS_CONNECTION_BATCH_CAPACITY) {
        batch.complete=false;countEvent(182u);
        batch.firstDiscarded=min(batch.firstDiscarded,position<GS_CONNECTION_BATCH_CAPACITY
            ?batch.events[GS_CONNECTION_BATCH_CAPACITY-1u].distance.x:rawT);
    }
    if(position<GS_CONNECTION_BATCH_CAPACITY) {
        uint last=min(batch.count,GS_CONNECTION_BATCH_CAPACITY-1u);
        while(last>position){batch.events[last]=batch.events[last-1u];--last;}
        batch.events[position]=event;
        batch.count=min(batch.count+1u,GS_CONNECTION_BATCH_CAPACITY);
    }
}
void main() {
#ifdef RTRENDERER_OPTICAL_PROFILE
    payload.diagnosticAddress=batch.diagnosticAddress;
    payload.diagnosticRecord=batch.diagnosticRecord;
#endif
    collectCandidate();
    if(batch.fallback)terminateRayEXT;
    else ignoreIntersectionEXT;
}
